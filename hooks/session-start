#!/usr/bin/env bash
# SessionStart hook for tsunu-superpowers plugin
# Injects the entry skill content into the system prompt at session start.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

entry_content=$(cat "${PLUGIN_ROOT}/skills/entry/SKILL.md" 2>&1 || echo "Error reading entry skill")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

entry_escaped=$(escape_for_json "$entry_content")
session_context="<EXTREMELY_IMPORTANT>\ntsunu-superpowers 已啟動。\n\n**以下是 'tsunu-superpowers:entry' skill 的完整內容——你的 skill 使用指南。其他 skill 請用 Skill tool 觸發：**\n\n${entry_escaped}\n</EXTREMELY_IMPORTANT>"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
